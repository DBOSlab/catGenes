begin mrbayes;
  set autoclose=yes;

  outgroup Abronia_bigelovii;

  [ ================================================ ]
  [ PARTITION DEFINITIONS                            ]
  [ ================================================ ]
  charset ITS = 1-690; [690 = ITS]
  charset rps16 = 691-1657; [967 = rps16]

  partition regions = 2: ITS, rps16;
  set partition = regions;

  [ ================================================ ]
  [ MODEL SETTINGS (optimized by evomodelTest).      ]
  [ ================================================ ]
  lset applyto=(1) nst=6 rates=invgamma ngammacat=4;
  lset applyto=(2) nst=6 rates=gamma ngammacat=4;
  prset applyto=(1) revmatpr=fixed(1,2,1,3,2,4);
  prset applyto=(2) revmatpr=fixed(1,2,3,2,1,3);

  [ ================================================ ]
  [ ADDITIONAL MRBAYES SETTINGS                      ]
  [ ================================================ ]
  [ Base frequencies (empirical) ]
  prset applyto=(all) statefreq=dirichlet(1,1,1,1);

  [ Allow different rates across partitions ]
  prset ratepr=variable;

  [ Unlink parameters between partitions ]
  unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all);

  [ MCMC settings (adjust as needed) ]
  mcmc ngen=10000000 samplefreq=10000 printfreq=10000
       nchains=8 nruns=2 savebrlens=yes filename=comb_Bayesian;

  [ Convergence diagnostics ]
  log start filename=comb_mrbayes_sump_sumt.log append;
  sump;
  sumt relburnin=yes burninfrac=0.25;
end;
